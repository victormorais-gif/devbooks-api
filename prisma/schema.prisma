generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Author {
  id        String   @id @default(uuid())
  name      String   @unique
  biography String?
  books     Book[]

  @@map("authors")
}
model Book {
  id           String   @id @default(uuid())
  title        String
  release_year Int
  author_id    String
  author       Author   @relation(fields: [author_id], references: [id])

  @@map("books")
}